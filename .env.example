# Database URL (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# WhatsApp Business API Configuration
# Token you choose to verify your webhook in the Meta Developer Portal
WHATSAPP_VERIFY_TOKEN="your_verify_token"
# Permanent or Temporary Access Token from Meta Developer Portal
WHATSAPP_API_TOKEN="your_whatsapp_api_token"
# App Secret from Meta Developer Portal (Settings -> Basic)
WHATSAPP_APP_SECRET="your_app_secret"

# Anthropic Claude API Configuration
# Your API Key from Anthropic Console
ANTHROPIC_API_KEY="your_anthropic_api_key"
